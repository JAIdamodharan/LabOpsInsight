# Copy this file to .env and put your real key after the equals sign (no quotes needed).
# .env is git-ignored. Run `chmod 600 .env` so only you can read it. Values already exported in your shell win over this file.
# NEVER commit a real key. On Vercel, add these as Environment Variables in the project settings instead of a file.

# --- one free provider key is enough (Groq has a free tier: https://console.groq.com) ---
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- optional defaults ---
# ANALYST_PROVIDER=groq
# ANALYST_MODEL=openai/gpt-oss-120b

# --- optional: server behaviour ---
# LABOPS_AUTH=0                  # 0 turns accounts off (single-user local use only)
# LABOPS_ALLOWED_HOSTS=my.domain # extra Host names to accept, comma separated

# --- hosted public demo (Vercel) ---
# LABOPS_PUBLIC_DEMO=1           # api/index.py always runs in this mode: read-only, no accounts, no uploads
# LABOPS_DEMO_LIVE=1             # let the public demo call the provider key above (default: scripted answers, spends no quota)
# Protection for live answers on the public demo (defaults shown). When a budget is used up, visitors get the scripted walkthrough.
# LABOPS_LIVE_IP_MINUTE=3        # live answers per visitor address per minute
# LABOPS_LIVE_IP_DAILY=6         # live answers per visitor address per day
# LABOPS_LIVE_GLOBAL_DAILY=200   # live answers per day across everyone
# LABOPS_LIVE_MAX_STEPS=6        # agent steps per live answer
# LABOPS_LIVE_TOKEN_BUDGET=40000 # tokens per live answer
# LABOPS_LIVE_MAX_QUESTION=300   # characters per question
# UPSTASH_REDIS_REST_URL=        # optional: shared counters across all Vercel instances (added automatically by the Upstash integration)
# UPSTASH_REDIS_REST_TOKEN=
